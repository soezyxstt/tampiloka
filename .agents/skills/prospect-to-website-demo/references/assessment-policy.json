{
  "version": 3,
  "threshold": 85,
  "minimumRating": 3,
  "criticalMinimums": {
    "brand": 4,
    "visual": 4,
    "interaction": 4
  },
  "dimensions": {
    "brand": {
      "weight": 18,
      "criterion": "Kecocokan sumber visual Instagram/menu/halaman resmi dengan hasil: proporsi warna, bentuk huruf/hierarki, komposisi, imagery dan bahasa grafis; bukan logo serta token saja."
    },
    "visual": {
      "weight": 18,
      "criterion": "Art direction khas merek, komposisi hero dan transisi section bermakna, ritme skala/crop/densitas pada desktop/mobile; dibandingkan visual dengan demo lain."
    },
    "information": {
      "weight": 14,
      "criterion": "Produk, harga/varian, lokasi dan kontak berguna, lengkap sesuai sumber, tanpa narasi riset internal. Copy hanya yang diperlukan; layout menjelaskan hubungan isi tanpa teks pengisi, informasi keputusan dan aksesibilitas tetap utuh."
    },
    "conversion": {
      "weight": 12,
      "criterion": "Satu aksi utama jelas, secondary terbedakan, ikon/destination benar, informasi menuju aksi mudah ditemukan."
    },
    "interaction": {
      "weight": 14,
      "criterion": "Shadcn asli, state/keyboard/fokus/kontras/tap target/overflow dan interaksi katalog benar."
    },
    "motion": {
      "weight": 8,
      "criterion": "Entrance, scroll dan state motion terarah; reduced motion, exit dan hydration benar."
    },
    "technical": {
      "weight": 10,
      "criterion": "Build/lint/typecheck, data dan aset valid, package mandiri, metadata dan console bersih."
    },
    "originality": {
      "weight": 6,
      "criterion": "Struktur berbeda secara bermakna dari demo terdahulu; variasi layak terhadap aset/tujuan dan tetap setia merek."
    }
  },
  "gates": [
    "identity_sources",
    "authentic_content",
    "explicit_design_rules",
    "working_actions",
    "responsive_keyboard",
    "truthful_scope",
    "layout_feasibility"
  ],
