NEXT_PUBLIC_SITE_URL=https://tampiloka.site
NEXT_PUBLIC_TEMURA_URL=https://temura.tampiloka.site
# Search engine verification tokens (optional, one per property).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# CMS secrets must be set separately for development and production.
CMS_DATABASE_URL=
CMS_STORAGE_ENDPOINT=
CMS_STORAGE_REGION=
CMS_STORAGE_BUCKET=
CMS_STORAGE_ACCESS_KEY_ID=
CMS_STORAGE_SECRET_ACCESS_KEY=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL_ALLOWLIST=

# Vercel sends this server-only secret as a Bearer token to the daily cron.
CRON_SECRET=
