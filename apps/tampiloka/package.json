{
  "name": "@tampiloka/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:brand": "node scripts/verify-brand.mjs",
    "verify:marketing": "node scripts/verify-marketing.mjs",
    "verify:bilingual-browser": "node scripts/verify-bilingual-browser.mjs",
    "verify:showcase-browser": "node scripts/verify-showcase-browser.mjs",
    "verify:templates-browser": "node scripts/verify-templates-browser.mjs",
    "verify:catalog": "node --experimental-strip-types --test scripts/template-catalog.test.mjs",
    "verify:select-motion": "node scripts/verify-select-motion.mjs",
    "verify:ui-browser": "node scripts/verify-ui-consistency-browser.mjs",
    "verify:pricing": "node scripts/verify-pricing.mjs",
    "prepare:images": "node scripts/prepare-images.mjs",
    "db:migrate": "drizzle-kit migrate",
    "test:forms-backend": "node --experimental-strip-types --test scripts/form-backend.test.mjs && bun test ./scripts/form-auth.test.ts ./scripts/form-api.test.ts",
    "test:forms": "bun test lib/forms lib/storage components/forms && bun test scripts/form-api.test.ts scripts/form-auth.test.ts scripts/form-proxy.test.ts scripts/form-maintenance-auth.test.ts && node --experimental-strip-types --test scripts/form-backend.test.mjs components/admin/form-editor-helpers.test.mjs scripts/purge-form-retention.test.mjs scripts/form-maintenance.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-presigned-post": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.1",
    "@tampiloka/brand-system": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
