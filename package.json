{
  "name": "tampiloka-temura-monorepo",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:tampiloka": "turbo run dev --filter=@tampiloka/web",
    "dev:temura": "turbo run dev --filter=@temura/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:brand": "turbo run check:brand",
    "verify:marketing": "turbo run verify:marketing --filter=@tampiloka/web",
    "prepare:images": "turbo run prepare:images --filter=@tampiloka/web"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "turbo": "^2.8.0"
  }
}
