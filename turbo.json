{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_TEMURA_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "DATABASE_URL",
        "ADMIN_WHATSAPP",
        "UPLOADTHING_TOKEN",
        "FONNTE_TOKEN",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_TEMURA_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "DATABASE_URL",
        "ADMIN_WHATSAPP",
        "UPLOADTHING_TOKEN",
        "FONNTE_TOKEN",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_TEMURA_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "DATABASE_URL",
        "ADMIN_WHATSAPP",
        "UPLOADTHING_TOKEN",
        "FONNTE_TOKEN",
        "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY"
      ]
    },
    "lint": {},
    "typecheck": {
      "passThroughEnv": [
        "DATABASE_URL"
      ]
    },
    "check:brand": {},
    "verify:marketing": {
      "cache": false,
      "passThroughEnv": [
        "MARKETING_ORIGIN"
      ]
    },
    "prepare:images": {
      "cache": false
    }
  }
}
